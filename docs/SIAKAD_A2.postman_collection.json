    {
      "name": "01 - Register dan login sebelum persetujuan",
      "item": [
        {
          "name": "Ambil CSRF (cookie disimpan otomatis)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrf_token}}"
              }
            ],
            "url": "{{base_url}}/api/csrf-token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = Date.now().toString();",
                  "pm.collectionVariables.set(\"applicant_username\", \"demo_\" + runId);",
                  "pm.collectionVariables.set(\"applicant_email\", \"demo_\" + runId + \"@example.test\");",
                  "pm.collectionVariables.set(\"run_id\", runId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register akun pending",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrf_token}}"
              }
            ],
            "url": "{{base_url}}/api/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Siswa Demo\",\n  \"username\": \"{{applicant_username}}\",\n  \"email\": \"{{applicant_email}}\",\n  \"password\": \"{{applicant_password}}\",\n  \"password_confirmation\": \"{{applicant_password}}\"\n}",
              "options": {
                "raw": {
