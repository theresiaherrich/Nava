  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "let body = {};",
          "try { body = pm.response.json(); } catch (e) {}",
          "if (body.csrf_token) pm.collectionVariables.set(\"csrf_token\", body.csrf_token);",
          "if (pm.request.url.toString().endsWith(\"/logout\") && pm.response.code === 200) pm.collectionVariables.unset(\"csrf_token\");"
        ]
      }
    }
